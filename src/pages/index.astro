---
import { getDocsNavigation } from '../utils/docs.utils';

const categories = await getDocsNavigation();
const firstDoc = categories[0]?.pages[0];

// Redirigir a la primera página de documentación
if (firstDoc) {
  return Astro.redirect(`/docs/${firstDoc.slug}`);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MicroDocs</title>
  </head>
  <body>
    <div class="flex items-center justify-center min-h-screen">
      <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">MicroDocs</h1>
        <p class="text-gray-600">No hay documentación disponible</p>
      </div>
    </div>
  </body>
</html>