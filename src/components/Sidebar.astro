---
import type { DocCategory } from '../types/docs.types';

interface Props {
  categories: DocCategory[];
  currentSlug?: string;
}

const { categories, currentSlug } = Astro.props;
---

<aside class="w-64 h-screen fixed left-0 top-0 bg-gray-50 border-r border-gray-200 overflow-y-auto">
  <div class="p-6">
    <a href="/" class="text-xl font-bold text-gray-900 hover:text-gray-700">
      MicroDocs
    </a>
  </div>

  <nav class="px-4 pb-8">
    {categories.map((category) => (
      <div class="mb-6">
        <h3 class="px-3 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
          {category.name}
        </h3>
        <ul class="space-y-1">
          {category.pages.map((page) => (
            <li>
              <a
                href={`/docs/${page.slug}`}
                class:list={[
                  "block px-3 py-2 rounded-md text-sm transition-colors",
                  currentSlug === page.slug
                    ? "bg-blue-50 text-blue-700 font-medium"
                    : "text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                ]}
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>