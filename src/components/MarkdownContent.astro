---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>

<style is:global>
  .prose {
    color: #1e293b;
    max-width: 75ch;
    line-height: 1.75;
  }

  /* Headings con gradiente sutil */
  .prose h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #0c0b58ff 0%, #1e40af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    color: #0c0b58ff;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e5e7eb;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #1e40af;
    letter-spacing: -0.01em;
  }

  .prose h4 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #334155;
  }

  /* Párrafos con mejor espaciado */
  .prose p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    line-height: 1.8;
    color: #334155;
  }

  /* Enlaces con hover effect moderno */
  .prose a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
    position: relative;
  }

  .prose a:hover {
    color: #1d4ed8;
    border-bottom-color: #2563eb;
  }

  /* Code inline mejorado */
  .prose code {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-weight: 600;
    color: #92400e;
    border: 1px solid #fbbf24;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  /* Code blocks con mejor diseño */
  .prose pre {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: #f1f5f9;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin-top: 2rem;
    margin-bottom: 2rem;
    border: 1px solid #334155;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    border: none;
    line-height: 1.7;
  }

  /* Listas mejoradas */
  .prose ul, .prose ol {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
  }

  .prose ul {
    list-style-type: none;
  }

  .prose ul > li {
    position: relative;
    padding-left: 1.5rem;
  }

  .prose ul > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    background: linear-gradient(135deg, #f8cf76ff 0%, #fbbf24 100%);
    border-radius: 50%;
  }

  .prose ol {
    counter-reset: list-counter;
  }

  .prose ol > li {
    counter-increment: list-counter;
    position: relative;
    padding-left: 1.75rem;
  }

  .prose ol > li::before {
    content: counter(list-counter) ".";
    position: absolute;
    left: 0;
    color: #f8cf76ff;
    font-weight: 700;
  }

  .prose li {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.75;
    color: #475569;
  }

  /* Blockquotes modernos */
  .prose blockquote {
    border-left: 4px solid #f8cf76ff;
    padding-left: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    font-style: italic;
    color: #64748b;
    margin-top: 2rem;
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #fef9e7 0%, transparent 100%);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .prose blockquote p {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  /* Imágenes con sombra */
  .prose img {
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
  }

  /* Tablas mejoradas */
  .prose table {
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  }

  .prose thead {
    background: linear-gradient(135deg, #f8cf76ff 0%, #fbbf24 100%);
  }

  .prose th {
    font-weight: 700;
    text-align: left;
    padding: 1rem 1.25rem;
    border: none;
    color: #92400e;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .prose tbody tr {
    transition: background-color 0.2s ease;
  }

  .prose tbody tr:nth-child(even) {
    background-color: #f9fafb;
  }

  .prose tbody tr:hover {
    background-color: #fef3c7;
  }

  .prose td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e5e7eb;
    color: #475569;
  }

  .prose tbody tr:last-child td {
    border-bottom: none;
  }

  /* HR mejorado */
  .prose hr {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, #e5e7eb 50%, transparent 100%);
    margin: 3rem 0;
  }

  /* Strong y em */
  .prose strong {
    color: #0f172a;
    font-weight: 700;
  }

  .prose em {
    color: #475569;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .prose {
      font-size: 0.95rem;
    }

    .prose h1 {
      font-size: 2rem;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }

    .prose pre {
      padding: 1rem;
      font-size: 0.8rem;
    }

    .prose table {
      font-size: 0.875rem;
    }

    .prose th,
    .prose td {
      padding: 0.75rem;
    }
  }
</style>