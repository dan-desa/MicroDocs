---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["prose minimal-prose max-w-none", className]}>
  <slot />
</div>

<style is:global>
  /* Estilo base minimalista */
  .minimal-prose {
    color: #444;
    max-width: 65ch;
    --accent: #f39c12; /* naranja suave */
  }

  .minimal-prose h1,
  .minimal-prose h2,
  .minimal-prose h3 {
    color: #222;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .minimal-prose h1 { font-size: 2rem; }
  .minimal-prose h2 { font-size: 1.5rem; }
  .minimal-prose h3 { font-size: 1.25rem; }

  .minimal-prose p {
    margin: 1rem 0;
    line-height: 1.7;
  }

  .minimal-prose a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
  }

  .minimal-prose a:hover {
    opacity: 0.8;
  }

  .minimal-prose code {
    background-color: #f5f5f5;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .minimal-prose pre {
    background-color: #292929;
    color: #fafafa;
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .minimal-prose pre code {
    background: transparent;
    font-size: 0.9rem;
  }

  .minimal-prose ul,
  .minimal-prose ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .minimal-prose li {
    margin: 0.4rem 0;
  }

  .minimal-prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    font-style: italic;
    color: #666;
    margin: 1.5rem 0;
  }

  .minimal-prose img {
    margin: 1.5rem 0;
    border-radius: 6px;
  }

  .minimal-prose table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
  }

  .minimal-prose th {
    background: #fafafa;
    font-weight: 600;
    padding: 0.75rem;
    border: 1px solid #ddd;
  }

  .minimal-prose td {
    padding: 0.75rem;
    border: 1px solid #ddd;
  }
</style>
